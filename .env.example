# Application Environment
FLASK_ENV=development
FLASK_APP=backend/run.py
SECRET_KEY=dev-secret-key-replace-in-production-min-32-chars

# PostgreSQL Database Configuration
# Local host development:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/intel_protect_db
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/intel_protect_test_db

# Docker Compose database credentials:
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=intel_protect_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# CORS & Server Ports
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
BACKEND_PORT=5000
FRONTEND_PORT=5173

# Vite Frontend API Base URL
VITE_API_BASE_URL=http://localhost:5000/api
